        },
        {
          "flag": "q",
          "description": "Quit the manual viewer (not a flag)."
        }
      ],
      "examples": [
        {
          "command": "man ls",
          "description": "Read the ls manual."
        },
        {
          "command": "man sort",
          "description": "Read the sort manual."
        },
        {
          "command": "man -k copy",
          "description": "Search for commands related to copying."
        }
      ],
      "keywords": [
        "manual",
        "help",
        "documentation"
      ],
      "note": "Manual pages may contain options beyond those in this quick reference.",
      "type": "utility"
    },
    {
      "id": "clear",
      "name": "clear",
      "category": "System",
      "summary": "Clear the terminal display",
      "description": "Clears the visible terminal screen.",
      "syntax": "clear",
      "options": [],
      "examples": [
        {
          "command": "clear",
          "description": "Clear the terminal."
        }
      ],
      "keywords": [
        "terminal",
        "screen",
        "clear"
      ],
      "note": null,
      "type": "utility"
    }
  ]
}
