{
  "schemaVersion": 1,
  "version": "1.0.0",
  "updatedAt": "2026-11-11",
  "commands": [
    {
      "id": "ls",
      "name": "ls",
      "category": "Files & Directories",
      "summary": "List files and directories",
      "description": "Lists files and folders in the current or a specified directory.",
      "syntax": "ls [options] [path]",
      "options": [
        {
          "flag": "-l",
          "description": "Show detailed information: permissions, ownership, size, and date."
        },
        {
          "flag": "-a",
          "description": "Include hidden entries beginning with a dot."
        },
        {
          "flag": "-h",
          "description": "Show human-readable file sizes, useful with -l."
        },
        {
          "flag": "-R",
          "description": "List subdirectories recursively."
        },
        {
          "flag": "-t",
          "description": "Sort by modification time."
        }
      ],
      "examples": [
        {
          "command": "ls",
          "description": "List the current directory."
        },
        {
          "command": "ls -lah",
          "description": "Show details, hidden entries, and readable sizes."
        },
        {
          "command": "ls ~/Documents",
          "description": "List another directory."
        }
      ],
      "keywords": [
        "list files",
        "list",
        "files",
        "directories",
        "hidden",
        "browse"
      ],
      "note": "Combine short flags: ls -la is equivalent to ls -l -a. Available options can differ by system.",
      "type": "utility"
    },
    {
      "id": "cd",
      "name": "cd",
      "category": "Files & Directories",
      "summary": "Change directory",
      "description": "Changes the Bash shell's current working directory.",
      "syntax": "cd [directory]",
      "options": [
        {
          "flag": "..",
          "description": "Parent directory (an argument, not a flag)."
        },
        {
          "flag": "~",
          "description": "Shortcut for your home directory."
        },
        {
          "flag": "-",
          "description": "Go to the previous directory (an argument, not a flag)."
        }
      ],
      "examples": [
        {
          "command": "cd ~/Documents",
          "description": "Go to Documents in your home directory."
        },
        {
          "command": "cd ..",
          "description": "Move up one directory level."
        },
        {
          "command": "cd -",
          "description": "Return to the previous directory."
        },
        {
          "command": "cd",
          "description": "Go to your home directory."
        }
      ],
      "keywords": [
        "change directory",
        "navigation",
        "folder",
        "change",
        "directory"
      ],
      "note": "cd changes your shell's location, not the location of files.",
      "type": "builtin"
    },
    {
      "id": "pwd",
      "name": "pwd",
      "category": "Files & Directories",
      "summary": "Print working directory",
      "description": "Prints the full path to the directory you are currently in.",
      "syntax": "pwd [-L|-P]",
      "options": [
        {
          "flag": "-L",
          "description": "Show the logical path, which may contain symbolic links."
        },
        {
          "flag": "-P",
          "description": "Resolve symbolic links and print the physical path."
        }
      ],
      "examples": [
        {
          "command": "pwd",
          "description": "Print the current directory."
        },
        {
          "command": "pwd -P",
          "description": "Print the physical path."
        }
      ],
      "keywords": [
        "path",
        "current directory",
        "current",
        "location",
        "directory"
      ],
      "note": null,
      "type": "builtin"
    },
    {
      "id": "mkdir",
      "name": "mkdir",
      "category": "Files & Directories",
      "summary": "Create directories",
      "description": "Creates one or more directories at the specified paths.",
      "syntax": "mkdir [options] directory...",
      "options": [
        {
          "flag": "-p",
          "description": "Create missing parent directories; allow directories that already exist."
        },
        {
          "flag": "-v",
          "description": "Print a message for each newly created directory."
        }
      ],
      "examples": [
        {
          "command": "mkdir notes",
          "description": "Create a directory named notes."
        },
        {
          "command": "mkdir -p projects/demo",
          "description": "Create nested directories, including missing parents."
        }
      ],
      "keywords": [
        "make directory",
        "folder",
        "make",
        "directory",
        "create"
      ],
      "note": null,
      "type": "utility"
    },
    {
      "id": "touch",
      "name": "touch",
      "category": "Files & Directories",
      "summary": "Create empty files or update timestamps",
      "description": "Updates file access and modification timestamps; by default creates missing files.",
      "syntax": "touch [options] file...",
      "options": [
        {
          "flag": "-c",
          "description": "Do not create missing files."
        },
        {
          "flag": "-a",
          "description": "Update the access timestamp."
        },
        {
          "flag": "-m",
          "description": "Update the modification timestamp."
        }
      ],
      "examples": [
        {
          "command": "touch notes.txt",
          "description": "Create an empty file if needed."
        },
        {
          "command": "touch -c existing.txt",
          "description": "Update timestamps only if the file exists."
        }
      ],
      "keywords": [
        "new file",
        "timestamps",
        "file",
        "create"
      ],
      "note": null,
      "type": "utility"
    },
    {
      "id": "cp",
      "name": "cp",
      "category": "Files & Directories",
      "summary": "Copy files and directories",
      "description": "Copies files and, with an option, entire directories.",
      "syntax": "cp [options] source destination",
      "options": [
        {
          "flag": "-r",
          "description": "Copy directories recursively."
        },
        {
          "flag": "-i",
          "description": "Ask before overwriting a destination."
        },
        {
          "flag": "-n",
          "description": "Avoid overwriting destinations when supported; behavior varies."
        },
        {
          "flag": "-v",
          "description": "Print the files being copied."
        }
      ],
      "examples": [
        {
          "command": "cp notes.txt backup.txt",
          "description": "Copy a file."
        },
        {
          "command": "cp -ri folder folder-backup",
          "description": "Copy a directory and request confirmation before overwriting."
        }
      ],
      "keywords": [
        "copy",
        "duplicate",
        "backup"
      ],
      "note": "Some flags differ between GNU and BSD implementations.",
      "type": "utility"
    },
    {
      "id": "mv",
      "name": "mv",
      "category": "Files & Directories",
      "summary": "Move or rename files",
      "description": "Moves files and folders or changes their names.",
      "syntax": "mv [options] source destination",
      "options": [
        {
          "flag": "-i",
          "description": "Ask before overwriting the destination."
        },
        {
          "flag": "-n",
          "description": "Avoid overwriting an existing target when supported."
        },
        {
          "flag": "-v",
          "description": "Show the entries that were moved."
        }
      ],
      "examples": [
        {
          "command": "mv old.txt new.txt",
          "description": "Rename a file."
        },
        {
          "command": "mv notes.txt ~/Documents/",
          "description": "Move a file into another directory."
        },
        {
          "command": "mv -i draft.txt final.txt",
          "description": "Ask before replacing an existing file."
        }
      ],
      "keywords": [
        "move",
        "rename",
        "relocate"
      ],
      "note": "A destination file may be replaced without warning unless protective options are used.",
      "type": "utility"
    },
    {
      "id": "rm",
      "name": "rm",
      "category": "Files & Directories",
      "summary": "Delete files",
      "description": "Deletes files, typically without moving them to Trash or Recycle Bin.",
      "syntax": "rm [options] file...",
      "options": [
        {
          "flag": "-i",
          "description": "Ask for confirmation before each deletion."
        },
        {
          "flag": "-r",
          "description": "Delete directories and their contents recursively; use caution."
        },
        {
          "flag": "-v",
          "description": "Print which items are removed."
        }
      ],
      "examples": [
        {
          "command": "rm -i old-notes.txt",
          "description": "Ask before deleting a file."
        },
        {
          "command": "rm unwanted.txt",
          "description": "Delete a file."
        }
      ],
      "keywords": [
        "delete",
        "remove",
        "file"
      ],
      "note": "Warning: rm deletions are usually difficult to undo. Check paths carefully and consider -i.",
      "type": "utility"
    },
    {
      "id": "cat",
      "name": "cat",
      "category": "Text & Search",
      "summary": "Display file contents",
      "description": "Prints the contents of files to the terminal; suitable for relatively short files.",
      "syntax": "cat [options] [file...]",
      "options": [
        {
          "flag": "-n",
          "description": "Number all output lines."
        },
        {
          "flag": "-b",
          "description": "Number only nonempty lines."
        },
        {
          "flag": "-s",
          "description": "Collapse repeated empty lines when supported."
        }
      ],
      "examples": [
        {
          "command": "cat notes.txt",
          "description": "Print a file's contents."
        },
        {
          "command": "cat -n notes.txt",
          "description": "Show a file with line numbers."
        }
      ],
      "keywords": [
        "read",
        "view",
        "print file",
        "print",
        "concatenate"
      ],
      "note": "Use less to browse long files.",
      "type": "utility"
    },
    {
      "id": "sort",
      "name": "sort",
      "category": "Text & Search",
      "summary": "Sort text lines",
      "description": "Sorts lines from files or standard input, using locale-specific ordering by default.",
      "syntax": "sort [options] [file...]",
      "options": [
        {
          "flag": "-n",
          "description": "Sort by numeric value."
        },
        {
          "flag": "-r",
          "description": "Reverse the order."
        },
        {
          "flag": "-u",
          "description": "Show unique lines only."
        },
        {
          "flag": "-k N",
          "description": "Sort using field N as the key."
        },
        {
          "flag": "-t CHAR",
          "description": "Choose the field separator."
        },
        {
          "flag": "-o FILE",
          "description": "Write sorted output to the specified file."
        }
      ],
      "examples": [
        {
          "command": "sort names.txt",
          "description": "Sort lines in ascending order."
        },
        {
          "command": "sort -nr numbers.txt",
          "description": "Sort numbers in descending order."
        },
        {
          "command": "sort -u names.txt",
          "description": "Sort and deduplicate lines."
        },
        {
          "command": "sort -t, -k2,2 people.csv",
          "description": "Sort simple CSV data by the second field."
        }
      ],
      "keywords": [
        "reverse",
        "numeric",
        "ascending",
        "descending",
        "sorting"
      ],
      "note": "Use -nr together for reverse numeric order.",
      "type": "utility"
    },
    {
      "id": "grep",
      "name": "grep",
      "category": "Text & Search",
      "summary": "Search for matching text",
      "description": "Searches text or regular expressions and prints matching lines.",
      "syntax": "grep [options] pattern [file...]",
      "options": [
        {
          "flag": "-i",
          "description": "Ignore uppercase/lowercase differences."
        },
        {
          "flag": "-n",
          "description": "Show matching line numbers."
        },
        {
          "flag": "-r",
          "description": "Search subdirectories recursively."
        },
        {
          "flag": "-v",
          "description": "Print lines that do not match."
        },
        {
          "flag": "-F",
          "description": "Treat the pattern as literal text."
        },
        {
          "flag": "-E",
          "description": "Enable extended regular expressions."
        }
      ],
      "examples": [
        {
          "command": "grep -n error app.log",
          "description": "Find error with line numbers."
        },
        {
          "command": "grep -ri hello .",
          "description": "Search recursively without case sensitivity."
        },
        {
          "command": "grep -F \"a.b\" notes.txt",
          "description": "Find the literal string a.b."
        }
      ],
      "keywords": [
        "search text",
        "pattern",
        "regex",
        "search",
        "text"
      ],
      "note": "Quote patterns containing spaces. Use -F for plain-text matching.",
      "type": "utility"
    },
    {
      "id": "find",
      "name": "find",
      "category": "Text & Search",
      "summary": "Find files by name or properties",
      "description": "Walks directory trees and selects files or directories matching an expression.",
      "syntax": "find [path...] [expression]",
      "options": [
        {
          "flag": "-name \"*.txt\"",
          "description": "Match filenames with a glob; quote the pattern."
        },
        {
          "flag": "-iname \"*.txt\"",
          "description": "Match filenames without case sensitivity when supported."
        },
        {
          "flag": "-type f",
          "description": "Match regular files only."
        },
        {
          "flag": "-type d",
          "description": "Match directories only."
        },
        {
          "flag": "-maxdepth N",
          "description": "Limit recursion depth on GNU find."
        }
      ],
      "examples": [
        {
          "command": "find . -name \"*.txt\"",
          "description": "Find .txt files under the current directory."
        },
        {
          "command": "find ~/Documents -type d",
          "description": "List directories under Documents."
        },
        {
          "command": "find . -type f -name \"report*\"",
          "description": "Find files whose names begin with report."
        }
      ],
      "keywords": [
        "find files",
        "files by name",
        "find",
        "locate",
        "files",
        "directories"
      ],
      "note": "Quote *.txt so Bash does not expand the pattern before find receives it.",
      "type": "utility"
    },
    {
      "id": "head",
      "name": "head",
      "category": "Text & Search",
      "summary": "Display the beginning of a file",
      "description": "Shows the first ten lines of a file by default.",
      "syntax": "head [options] [file...]",
      "options": [
        {
          "flag": "-n N",
          "description": "Show the first N lines."
        },
        {
          "flag": "-c N",
          "description": "Show the first N bytes."
        }
      ],
      "examples": [
        {
          "command": "head notes.txt",
          "description": "Show the first ten lines."
        },
        {
          "command": "head -n 5 notes.txt",
          "description": "Show the first five lines."
        }
      ],
      "keywords": [
        "first lines",
        "preview",
        "first",
        "lines"
      ],
      "note": null,
      "type": "utility"
    },
    {
      "id": "tail",
      "name": "tail",
      "category": "Text & Search",
      "summary": "Display the end of a file",
      "description": "Shows the last ten lines of a file by default, optionally following additions.",
      "syntax": "tail [options] [file...]",
      "options": [
        {
          "flag": "-n N",
          "description": "Show the last N lines."
        },
        {
          "flag": "-f",
          "description": "Follow new lines as they are added."
        },
        {
          "flag": "-c N",
          "description": "Show the last N bytes."
        }
      ],
      "examples": [
        {
          "command": "tail notes.txt",
          "description": "Show the last ten lines."
        },
        {
          "command": "tail -n 20 app.log",
          "description": "Show the last twenty lines."
        },
        {
          "command": "tail -f app.log",
          "description": "Follow a log file; press Ctrl+C to stop."
        }
      ],
      "keywords": [
        "last lines",
        "logs",
        "follow",
        "last",
        "lines"
      ],
      "note": null,
      "type": "utility"
    },
    {
      "id": "wc",
      "name": "wc",
      "category": "Text & Search",
      "summary": "Count lines, words, and bytes",
      "description": "Counts words, newline characters, bytes, or characters in files or input.",
      "syntax": "wc [options] [file...]",
      "options": [
        {
          "flag": "-l",
          "description": "Count newline characters."
        },
        {
          "flag": "-w",
          "description": "Count words."
        },
        {
          "flag": "-c",
          "description": "Count bytes."
        },
        {
          "flag": "-m",
          "description": "Count characters according to the locale."
        }
      ],
      "examples": [
        {
          "command": "wc notes.txt",
          "description": "Show line, word, and byte counts."
        },
        {
          "command": "wc -l notes.txt",
          "description": "Count newline characters."
        },
        {
          "command": "wc -w essay.txt",
          "description": "Count words."
        }
      ],
      "keywords": [
        "count",
        "word count",
        "lines",
        "word",
        "bytes"
      ],
      "note": "wc -l counts newline characters; a final line without a newline might not be counted.",
      "type": "utility"
    },
    {
      "id": "less",
      "name": "less",
      "category": "Text & Search",
      "summary": "Browse long text files",
      "description": "Opens text in a scrollable pager instead of flooding the terminal.",
      "syntax": "less [options] file",
      "options": [
        {
          "flag": "-N",
          "description": "Show line numbers."
        },
        {
          "flag": "-S",
          "description": "Do not wrap long lines."
        },
        {
          "flag": "/text",
          "description": "Search for text inside less (not a flag)."
        },
        {
          "flag": "q",
          "description": "Quit the pager (a key, not a flag)."
        }
      ],
      "examples": [
        {
          "command": "less README.md",
          "description": "Open a file for browsing."
        },
        {
          "command": "less -N app.log",
          "description": "Browse a log with line numbers."
        }
      ],
      "keywords": [
        "pager",
        "scroll",
        "view file",
        "view",
        "file"
      ],
      "note": "Use arrows to scroll, / to search, and q to quit.",
      "type": "utility"
    },
    {
      "id": "echo",
      "name": "echo",
      "category": "System",
      "summary": "Print text or variable values",
      "description": "Prints its arguments; echo is a Bash builtin.",
      "syntax": "echo [options] [text...]",
      "options": [
        {
          "flag": "-n",
          "description": "Omit the trailing newline."
        },
        {
          "flag": "$HOME",
          "description": "Example of variable expansion; not a flag."
        }
      ],
      "examples": [
        {
          "command": "echo \"Hello\"",
          "description": "Print Hello."
        },
        {
          "command": "echo \"$HOME\"",
          "description": "Print your home directory path."
        }
      ],
      "keywords": [
        "print",
        "output",
        "variables",
        "text"
      ],
      "note": "For precise and portable formatting, consider printf.",
      "type": "builtin"
    },
    {
      "id": "man",
      "name": "man",
      "category": "System",
