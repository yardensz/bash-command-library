    {
      "id": "find",
      "name": "find",
      "category": "טקסט וחיפוש",
      "summary": "איתור קבצים לפי שם ותכונות",
      "description": "סורק עץ תיקיות ומסנן קבצים לפי קריטריונים. הסדר של הפרמטרים יכול להשפיע.",
      "syntax": "find [path...] [expression]",
      "options": [
        {
          "flag": "-name \"*.txt\"",
          "description": "איתור לפי שם באמצעות תבנית glob; מומלץ לשים במירכאות."
        },
        {
          "flag": "-iname \"*.txt\"",
          "description": "כמו ‎-name, ללא הבדל בין אותיות גדולות/קטנות (נפוץ)."
        },
        {
          "flag": "-type f",
          "description": "קבצים רגילים בלבד."
        },
        {
          "flag": "-type d",
          "description": "תיקיות בלבד."
        },
        {
          "flag": "-maxdepth N",
          "description": "מגביל עומק חיפוש (GNU find; לא זמין בכל מערכת)."
        }
      ],
      "examples": [
        {
          "command": "find . -name \"*.txt\"",
          "description": "איתור קובצי txt בתיקייה הנוכחית ומתחתיה."
        },
        {
          "command": "find ~/Documents -type d",
          "description": "הצגת תיקיות ב־Documents."
        },
        {
          "command": "find . -type f -name \"report*\"",
          "description": "מציאת קבצים ששמם מתחיל ב־report."
        }
      ],
      "keywords": [
        "find files",
        "איתור קבצים",
        "תיקיות",
        "files by name"
      ],
      "note": "המרכאות סביב *.txt מונעות מה־Shell להרחיב את הכוכבית לפני ש־find מקבל אותה.",
      "type": "utility"
    },
