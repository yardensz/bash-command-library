  "commands": [
    {
      "id": "ls",
      "name": "ls",
      "category": "קבצים ותיקיות",
      "summary": "הצגת קבצים ותיקיות",
      "description": "מציג את תוכן התיקייה הנוכחית, או את התיקייה שציינת.",
      "syntax": "ls [options] [path]",
      "options": [
        {
          "flag": "-l",
          "description": "רשימה מפורטת עם הרשאות, בעלים, גודל ותאריך."
        },
        {
          "flag": "-a",
          "description": "כולל פריטים מוסתרים ששמם מתחיל בנקודה."
        },
        {
          "flag": "-h",
          "description": "גדלים קריאים לאדם; שימושי בשילוב ‎-l."
        },
        {
          "flag": "-R",
          "description": "מציג גם תיקיות משנה באופן רקורסיבי."
        },
        {
          "flag": "-t",
          "description": "ממיין לפי זמן השינוי האחרון."
        }
      ],
      "examples": [
        {
          "command": "ls",
          "description": "הצגת התיקייה הנוכחית."
        },
        {
          "command": "ls -lah",
          "description": "הצגה מפורטת, עם קבצים מוסתרים וגדלים קריאים."
        },
        {
          "command": "ls ~/Documents",
          "description": "הצגת תיקייה אחרת."
        }
      ],
      "keywords": [
        "רשימת קבצים",
        "הצגה",
        "list files"
      ],
      "note": "ב־Linux אפשר לשלב אפשרויות קצרות: ls -l -a שקול ל־ls -la. אפשרויות עשויות להשתנות במערכות שונות.",
      "type": "utility"
    },
    {
